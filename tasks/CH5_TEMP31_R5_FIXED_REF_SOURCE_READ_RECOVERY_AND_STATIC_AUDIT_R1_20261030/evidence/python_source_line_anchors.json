            {
              "line": 25,
              "text": "def matlab_contaminated_row_index(state_count: int) -> int:"
            },
            {
              "line": 26,
              "text": "    if state_count < 3:"
            },
            {
              "line": 27,
              "text": "        raise ValueError(\"faithful KFE requires at least three states\")"
            },
            {
              "line": 28,
              "text": "    return int(np.floor(0.37 * state_count)) - 1"
            },
            {
              "line": 29,
              "text": ""
            },
            {
              "line": 30,
              "text": "def solve_matlab_faithful_stationary_kfe(post_convergence_operator, *, shape, db, da):"
            },
            {
              "line": 31,
              "text": "    operator=sparse.csr_matrix(post_convergence_operator,dtype=float)"
            },
            {
              "line": 32,
              "text": "    size=int(np.prod(shape))"
            },
            {
              "line": 33,
              "text": "    if operator.shape!=(size,size) or len(shape)!=3 or min(shape)<1:"
            },
            {
              "line": 34,
              "text": "        raise ValueError(\"operator and faithful (b,a,z) shape are incompatible\")"
            },
            {
              "line": 35,
              "text": "    if not np.isfinite(operator.data).all() or not np.isfinite([db,da]).all() or db<=0 or da<=0:"
            },
            {
              "line": 36,
              "text": "        raise ValueError(\"faithful KFE inputs must be finite with positive spacings\")"
            },
            {
              "line": 37,
              "text": "    transpose=operator.transpose().tocsr()"
            },
            {
              "line": 38,
              "text": "    row=matlab_contaminated_row_index(size)"
            },
            {
              "line": 39,
              "text": "    contaminated=transpose.tolil(copy=True); contaminated[row,:]=0.0; contaminated[row,row]=1.0; contaminated=contaminated.tocsr()"
            },
            {
              "line": 40,
              "text": "    rhs=np.zeros(size); rhs[row]=0.007"
            },
            {
              "line": 41,
              "text": "    raw=np.asarray(linalg.spsolve(contaminated,rhs),dtype=float)"
            },
            {
              "line": 42,
              "text": "    if not np.isfinite(raw).all(): raise ValueError(\"faithful contaminated-row solve is non-finite\")"
            },
            {
              "line": 43,
              "text": "    factor=float(np.sum(raw)*db*da)"
            },
            {
              "line": 44,
              "text": "    if not np.isfinite(factor) or factor==0.0: raise ValueError(\"faithful density normalization is invalid\")"
            },
            {
              "line": 45,
              "text": "    density=raw/factor"
            },
            {
              "line": 46,
              "text": "    residual=float(np.linalg.norm(contaminated@raw-rhs,ord=np.inf))"
            },
            {
              "line": 47,
              "text": "    return MatlabFaithfulKFEResult(operator,transpose,row,contaminated,rhs,raw,factor,density,density.reshape(tuple(shape),order=\"F\"),float(db),float(da),float(db*da),residual)"
            }
          ]
        }
      ]
    },
