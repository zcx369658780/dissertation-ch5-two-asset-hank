            {
              "line": 19,
              "text": "def assemble_source_axis("
            },
            {
              "line": 20,
              "text": "    backward: np.ndarray, forward: np.ndarray, axis: int"
            },
            {
              "line": 21,
              "text": ") -> sparse.csr_matrix:"
            },
            {
              "line": 22,
              "text": "    \"\"\"Place signed source components, truncating outward entries but not their diagonal.\"\"\""
            },
            {
              "line": 23,
              "text": "    backward = np.asarray(backward, dtype=float)"
            },
            {
              "line": 24,
              "text": "    forward = np.asarray(forward, dtype=float)"
            },
            {
              "line": 25,
              "text": "    if backward.shape != forward.shape or backward.ndim != 3:"
            },
            {
              "line": 26,
              "text": "        raise ValueError(\"source axis components must share a three-dimensional shape\")"
            },
            {
              "line": 27,
              "text": "    if axis not in (0, 1) or not np.isfinite(backward).all() or not np.isfinite(forward).all():"
            },
            {
              "line": 28,
              "text": "        raise ValueError(\"invalid source axis components\")"
            },
            {
              "line": 29,
              "text": "    i_count, j_count, z_count = backward.shape"
            },
            {
              "line": 30,
              "text": "    rows: list[int] = []"
            },
            {
              "line": 31,
              "text": "    cols: list[int] = []"
            },
            {
              "line": 32,
              "text": "    data: list[float] = []"
            },
            {
              "line": 33,
              "text": "    for nz in range(z_count):"
            },
            {
              "line": 34,
              "text": "        for j in range(j_count):"
            },
            {
              "line": 35,
              "text": "            for i in range(i_count):"
            },
            {
              "line": 36,
              "text": "                row = i + j * i_count + nz * i_count * j_count"
            },
            {
              "line": 37,
              "text": "                rb = float(backward[i, j, nz])"
            },
            {
              "line": 38,
              "text": "                rf = float(forward[i, j, nz])"
            },
            {
              "line": 39,
              "text": "                if rb != 0.0 and ((axis == 0 and i > 0) or (axis == 1 and j > 0)):"
            },
            {
              "line": 40,
              "text": "                    rows.append(row); cols.append(row - (1 if axis == 0 else i_count)); data.append(rb)"
            },
            {
              "line": 41,
              "text": "                if rf != 0.0 and ((axis == 0 and i + 1 < i_count) or (axis == 1 and j + 1 < j_count)):"
            },
            {
              "line": 42,
              "text": "                    rows.append(row); cols.append(row + (1 if axis == 0 else i_count)); data.append(rf)"
            },
            {
              "line": 43,
              "text": "                rows.append(row); cols.append(row); data.append(-(rb + rf))"
            },
            {
              "line": 44,
              "text": "    size = i_count * j_count * z_count"
            },
            {
              "line": 45,
              "text": "    return sparse.coo_matrix((data, (rows, cols)), shape=(size, size)).tocsr()"
            },
            {
              "line": 46,
              "text": ""
            },
            {
              "line": 47,
              "text": ""
            },
            {
              "line": 48,
              "text": "def assemble_source_operator("
            },
            {
              "line": 49,
              "text": "    b_backward: np.ndarray,"
            },
            {
              "line": 50,
              "text": "    b_forward: np.ndarray,"
            },
            {
              "line": 51,
              "text": "    a_backward: np.ndarray,"
            },
            {
              "line": 52,
              "text": "    a_forward: np.ndarray,"
            },
            {
              "line": 53,
              "text": "    switch_matrix: np.ndarray,"
            },
            {
              "line": 54,
              "text": ") -> MatlabFaithfulOperator:"
            },
            {
              "line": 55,
              "text": "    bb = assemble_source_axis(b_backward, b_forward, 0)"
            },
            {
              "line": 56,
              "text": "    aah = assemble_source_axis(a_backward, a_forward, 1)"
            },
            {
              "line": 57,
              "text": "    state_size = int(np.prod(b_backward.shape[:2]))"
            },
            {
              "line": 58,
              "text": "    bswitch = sparse.kron(sparse.csr_matrix(switch_matrix), sparse.eye(state_size), format=\"csr\")"
            },
            {
              "line": 59,
              "text": "    return MatlabFaithfulOperator(bb, aah, bswitch, (bb + aah + bswitch).tocsr())"
            }
          ]
        }
      ]
